[Unit]
Description=WhatsApp bot of the Parasha agent: stores (un)subscriptions and sends the Parasha on subscribing
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
WorkingDirectory=__APP_DIR__
# A container left over from an unclean stop would block the name
ExecStartPre=-/usr/bin/docker rm -f my-agent-whatsapp-bot
# The fixed hostname (shared with my-agent.service) lets Chromium clear a stale profile lock left by a crash
ExecStart=/usr/bin/docker run --rm --name my-agent-whatsapp-bot --hostname my-agent-whatsapp \
    --env-file __APP_DIR__/.env \
    -v __APP_DIR__/.logfire:/app/.logfire:ro \
    -v __APP_DIR__/.wwebjs_auth:/app/whatsapp/.wwebjs_auth \
    -v __APP_DIR__/data:/app/data \
    my-agent:latest /app/.venv/bin/python main.py --whatsapp-bot
# Give the browser time to close cleanly, so the linked session stays usable
ExecStop=/usr/bin/docker stop -t 40 my-agent-whatsapp-bot
TimeoutStopSec=60
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
