[Unit]
Description=Store new Telegram subscribers every 12 hours (Telegram keeps bot messages for only ~24h)

[Timer]
# Off the weekly send's 08:00, so the two runs don't update the subscribers file at the same time
OnCalendar=*-*-* 02,14:00:00 Asia/Jerusalem
Persistent=true

[Install]
WantedBy=timers.target
